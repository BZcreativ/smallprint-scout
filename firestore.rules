rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: users/{userId}/scans
// Document ID: auto-generated
// Owner: the signed-in user whose uid == {userId} (from the path, so no uid field)
// Privacy: summaries only. No contract text, quotes or free text is ever stored.
// Fields (no others allowed):
//   - documentType: string (required, one of SUBSCRIPTION_TERMS, FREE_TRIAL,
//                   PRIVACY_AI_CLAUSE, SERVICE_AGREEMENT, OTHER)
//   - overallRisk:  string (required, one of LOW, MEDIUM, HIGH)
//   - categories:   list<string> (required, 0-7 items, each one of PRICE, RENEWAL,
//                   CANCELLATION, REFUND, RIGHTS, PRIVACY, OTHER)
//   - findingCount: int (required, 0-3)
//   - route:        string (required, one of ON_DEVICE, IN_CLOUD, UNKNOWN)
//   - createdAt:    timestamp (required, set to request.time on create, immutable)
//
// Access: owner can create, read (get + the app's orderBy(createdAt) query) and delete.
// Updates are denied: a scan summary is a fixed record.
// Everything else in the database is denied.
//
// Mirrors src/domain/scan-summary.ts. Change both together.
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================
    function isValidScan(data) {
      let fields = ['documentType', 'overallRisk', 'categories', 'findingCount', 'route', 'createdAt'];
      let categoryValues = ['PRICE', 'RENEWAL', 'CANCELLATION', 'REFUND', 'RIGHTS', 'PRIVACY', 'OTHER'];
      return hasRequiredFields(fields) &&
        hasOnlyAllowedFields(fields) &&
        data.documentType in ['SUBSCRIPTION_TERMS', 'FREE_TRIAL', 'PRIVACY_AI_CLAUSE', 'SERVICE_AGREEMENT', 'OTHER'] &&
        data.overallRisk in ['LOW', 'MEDIUM', 'HIGH'] &&
        data.route in ['ON_DEVICE', 'IN_CLOUD', 'UNKNOWN'] &&
        data.findingCount is int && data.findingCount >= 0 && data.findingCount <= 3 &&
        data.categories is list && data.categories.size() <= 7 &&
        // Every item must be an allowed category (also rejects non-strings).
        categoryValues.toSet().hasAll(data.categories) &&
        data.createdAt is timestamp;
    }

    // ===============================================================
    // Rules
    // ===============================================================
    match /users/{userId}/scans/{scanId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) &&
        isValidScan(request.resource.data) &&
        request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isOwner(userId);
    }

    // Default deny for every other path.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
