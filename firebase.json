{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "auth": {
    "providers": {
      "googleSignIn": {
        "oAuthBrandDisplayName": "SmallPrint Scout",
        "supportEmail": "buzman@gmail.com",
        "authorizedRedirectUris": [
          "https://smallprint-scout.firebaseapp.com/__/auth/handler",
          "http://localhost"
        ]
      }
    }
  },
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [{ "source": "**", "destination": "/index.html" }],
    "headers": [
      { "source": "**", "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }] },
      { "source": "/assets/**", "headers": [{ "key": "Cache-Control", "value": "max-age=31536000, immutable" }] }
    ]
  },
  "emulators": {
    "firestore": { "host": "127.0.0.1", "port": 8181 },
    "ui": { "enabled": false }
  }
}
