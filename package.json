{
  "name": "smallprint-scout",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "zip:extension": "node scripts/zip-extension.mjs",
    "test:rules": "npx -y firebase-tools@latest emulators:exec --only firestore --project demo-smallprint-scout \"cross-env RULES_TEST=1 vitest run tests/rules\""
  },
  "dependencies": {
    "dompurify": "^3.4.18",
    "firebase": "^13.3.0",
    "marked": "^18.2.1",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cross-env": "^10.1.0",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
