# Copy to .env.local (never commit it) and fill in from:
#   npx -y firebase-tools@latest apps:sdkconfig WEB <APP_ID> --project buildhybridai-32b9d
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional: leave empty to use the "(default)" Firestore database
VITE_FIRESTORE_DATABASE_ID=
