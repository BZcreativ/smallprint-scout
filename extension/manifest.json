{
  "manifest_version": 3,
  "name": "SmallPrint Scout",
  "version": "0.1.0",
  "description": "Scan consumer agreements on-device with Gemini Nano before you sign.",
  "permissions": ["activeTab", "scripting", "sidePanel", "contextMenus", "storage"],
  "optional_host_permissions": ["*://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "SmallPrint Scout"
  }
}
